{
  "name": "shaman-api-solution",
  "version": "3.0.4",
  "description": "Solution wrapper for shaman-api projects.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "restore": "shaman install",
    "build": "shaman build",
    "publish": "shaman publish",
    "debug": "shaman build && shaman serve shaman-api-sample",
    "sample": "shaman serve shaman-api-sample",
    "release": "docker run --rm -it -v ./build.sh:/app/entrypoint.sh -e GH_TOKEN=$GH_TOKEN --entrypoint bash shaman-ci /app/entrypoint.sh"
  },
  "license": "MIT",
  "dependencies": {
    "shaman-cli": "^1.0.19"
  }
}